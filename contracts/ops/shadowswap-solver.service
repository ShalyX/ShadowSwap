[Unit]
Description=ShadowSwap Sepolia batch solver
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=shadowswap
Group=shadowswap
WorkingDirectory=/opt/shadowswap-solver
EnvironmentFile=/etc/shadowswap/solver.env
Environment=NODE_ENV=production
Environment=SOLVER_POLL_MS=30000
Environment=SOLVER_MAX_SCAN=200
Environment=SOLVER_MIN_BATCH_ID=7
Environment=SOLVER_MAX_BATCH_ID=7
Environment=SOLVER_MIN_GAS_WEI=1000000000000000
ExecStart=/opt/shadowswap-solver/bin/node --import tsx scripts/solver-bot.ts
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
